# StudiKitEZ backend env — reference + copy-paste source for Vercel Dashboard.
# .env (gitignored) is for LOCAL dev only. Vercel NEVER reads any .env file.
# Firebase/AdSense values below are PUBLIC browser identifiers (also baked as
# code defaults); real protection = Firestore rules + Firebase key restrictions.
# The ONLY true secret here is SESSION_SECRET — keep it EMPTY in this file.

# Comma-separated origins allowed to call POST routes.
ALLOWED_ORIGINS=https://studikites.vercel.app,http://localhost:8091

# Signs phone sessions for verified playback. REQUIRED on Vercel (Dashboard env).
# NEVER put a real value in this committed file. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=0cbdeb7f9afee6ce9b8e792abe90995a57bd6bf48e05a9e93a6d0c65649847fa

# Stable route dictionary: frontend never changes when vendors change.

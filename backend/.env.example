# StudiKitEZ backend env — copy to .env (never commit .env).
# Public browser keys are served ONLY via GET /api/config; nothing secret ships in JS.

# Comma-separated origins allowed to call POST routes. Empty = allow all (dev only).
ALLOWED_ORIGINS=https://studikites.vercel.app,http://localhost:8091

# Signs phone sessions for verified playback. REQUIRED on Vercel.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Stable route dictionary: frontend never changes when vendors change.
MEDIA_ROUTES_JSON={"nig":"https://nt.studybeepro.site/api/nig","play":"https://nt.studybeepro.site/api/play"}
MIRROR_NIG_URL=https://nts.khatikgaurav38.workers.dev
OTP_BASE_URL=https://chutapi.smexfot.workers.dev
UPSTREAM_TIMEOUT_MS=20000

# Public Firebase browser configs (served via /api/config; restrict keys in Firebase console).
FIREBASE_SMEXGOD_API_KEY=
FIREBASE_SMEXGOD_AUTH_DOMAIN=
FIREBASE_SMEXGOD_PROJECT_ID=
FIREBASE_SMEXGOD_STORAGE_BUCKET=
FIREBASE_SMEXGOD_SENDER_ID=
FIREBASE_SMEXGOD_APP_ID=
FIREBASE_STUDIKI_API_KEY=
FIREBASE_STUDIKI_AUTH_DOMAIN=
FIREBASE_STUDIKI_PROJECT_ID=
FIREBASE_STUDIKI_STORAGE_BUCKET=
FIREBASE_STUDIKI_SENDER_ID=
FIREBASE_STUDIKI_APP_ID=
FIREBASE_STUDIKI_MEASUREMENT_ID=

SITE_URL=https://studikitesz.pages.dev
TELEGRAM_URL=https://t.me/studikitez

# Optional display ads only (no popunders, no social bars).
ADSENSE_CLIENT=
ADSENSE_SLOT_BANNER=
ADSENSE_SLOT_FEED=
ADSENSE_SLOT_INARTICLE=
ADSENSE_SLOT_MULTIPLEX=
ADSENSE_FEED_KEY=

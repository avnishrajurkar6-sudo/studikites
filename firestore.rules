rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    /* StudiKitEZ supports phone learners who authenticate with a signed
       server-side session instead of Firebase Auth, so reads stay open and
       *profile* writes stay open — but privilege, ban and subscription fields
       are locked to admins. Admin status comes from users/{uid}.role, which
       /api/auth/is-admin self-heals for allowlisted emails. */
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(db)/documents/users/$(request.auth.uid))
        && get(/databases/$(db)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{uid} {
      allow read: if true;
      allow create: if !('role' in request.resource.data) || request.resource.data.role != 'admin' || isAdmin();
      allow update: if isAdmin()
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'displayName', 'name', 'photoURL', 'email', 'mobile', 'contactMobile', 'provider',
             'onboarding', 'updatedAt', 'lastLoginAt', 'createdAt',
             'activity', 'activityAt', 'gamification', 'prefs',
             'referralFreeUntil', 'telegram', 'telegramVerified', 'telegramId',
             'telegramUsername', 'telegramFirstName', 'telegramLinkedAt'
           ]);
      allow delete: if false;

      match /inbox/{msg} {
        allow read, create, update: if true;      // admin → user notices + DM copies
        allow delete: if false;
      }
      match /noticeViews/{notice} {
        allow read, write: if true;
      }
    }

    match /progress/{uid}/batches/{batch} { allow read, write: if true; }
    match /studyLog/{id} { allow read, write: if true; }
    match /notes/{id} { allow read, write: if true; }
    match /referral_claims/{id} { allow read, write: if true; }
    match /presence/{uid} { allow read, write: if true; }
    match /focus_rooms/{room} {
      allow read, write: if true;
      match /messages/{msg} { allow read, write: if true; }
    }
    match /announcements/{id} {
      allow read: if true;
      allow write: if true;                        // admin panel only in practice
    }
    match /notices/{id} {
      allow read: if true;
      allow write: if true;                        // admin panel only in practice
    }
    match /posts/{id} {
      allow read: if true;
      allow create, update, delete: if true;
      match /likes/{uid} { allow read, write: if true; }
      match /comments/{cid} { allow read, write: if true; }
      match /votes/{uid} { allow read, write: if true; }
    }
    match /post_reports/{id} { allow read, write: if true; }
    match /threads/{id} {
      allow read, write: if true;
      match /messages/{msg} { allow read, write: if true; }
    }
    match /lecture_chats/{id} {
      allow read, write: if true;
      match /messages/{msg} { allow read, write: if true; }
    }
    match /forceMsgs/{uid} {
      allow read: if true;
      allow write: if true;                        // admin sends/releases; learner bumps view count
      match /votes/{voter} { allow read, write: if true; }
    }
    match /forceViews/{uid} { allow read, write: if true; }
    match /telegram_links/{token} {
      allow read, write: if false;                 // service account only
    }
    match /app_auth_codes/{code} {
      allow read, write: if false;                 // temporary app auth codes; service account only
    }
    match /app/{ver} { allow read, write: if true; }
    match /contact_messages/{id} { allow read, write: if true; }
    match /feedback/{id} { allow read, write: if true; }
    match /waitlist/{id} { allow read, write: if true; }
  }
}
